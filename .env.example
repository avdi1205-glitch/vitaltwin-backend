SUPABASE_URL=
SUPABASE_KEY=
# Privileged, server-only credential (Supabase Dashboard -> Project Settings
# -> API -> "service_role" secret key). Required for vt_beta_applications
# (RLS enabled, zero anon policies) — POST /api/beta/apply and the admin
# beta-application endpoints fail closed (503) without this set. NEVER
# expose this key to the frontend, never prefix with NEXT_PUBLIC_, never log it.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
# Legacy single-tier price ID. Still honored as a fallback for premium/monthly
# if STRIPE_PRICE_PREMIUM_MONTHLY is not set (see backend/app/core/plans.py).
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=0
FRONTEND_BASE_URL=https://www.vitaltwin.de

# Sentry error tracking (backend). Create a separate Python/FastAPI project
# in the same Sentry org used for the frontend (sentry.io -> Projects ->
# Create Project -> Python/FastAPI), then paste its DSN here. Leave empty
# and the backend runs exactly as before — init_sentry() is a no-op.
# Request bodies/cookies/PII are never sent (see core/sentry_setup.py).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0.0-1.0 share of requests traced for performance monitoring.
SENTRY_TRACES_SAMPLE_RATE=0.2
JWT_SECRET_KEY=

# Per-plan, per-interval Stripe Price IDs (Block 3: Preisseite/Tarifstruktur).
# Leave a variable empty/unset if that plan+interval isn't sellable yet —
# the backend will reject checkout attempts for it with a clear error
# instead of charging an unintended price.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=

# "Frag deinen Twin" wellness assistant (Block 6). Leave empty and the chat
# endpoint responds with a clear "currently unavailable" message instead of
# crashing — no fake/placeholder key is ever used.
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini if unset.
OPENAI_MODEL=

# Kontaktformular (/kontakt) -> best-effort E-Mail-Weiterleitung an das
# IONOS-Postfach info@vitaltwin.de. Leave empty and messages are still safely
# stored in vt_contact_messages, just without an outgoing notification email.
# IONOS SMTP-Server: smtp.ionos.de, Port 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional, defaults to SMTP_USER if unset.
CONTACT_NOTIFY_EMAIL=

# Founder OS — CI/CD & scheduler webhooks (all optional). Each endpoint is
# disabled (503) until its own secret below is set — generate e.g. via
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` and put the
# same value in the calling CI/CD job's / cron scheduler's own secret store
# (e.g. a GitHub Actions secret), sent as the `X-Webhook-Secret` header.
# POST /api/admin/system/releases/webhook — call at the end of a deploy job.
RELEASE_WEBHOOK_SECRET=
# POST /api/admin/system/backups/webhook — call when a backup job finishes.
BACKUP_WEBHOOK_SECRET=
# POST /api/admin/founder/automation/run-due/webhook — call periodically
# (e.g. every 15 min) from an external scheduler (Railway Cron, GitHub
# Actions scheduled workflow, cron-job.org) since no internal scheduler
# exists — without this, due automation rules only run when a human opens
# the Automation Engine dashboard tab.
AUTOMATION_SCHEDULER_WEBHOOK_SECRET=

# Google Health integration (separate OAuth client from Google Sign-In —
# different Client ID/Secret, different scopes, different purpose). Leave
# empty and /api/health/google/connect responds with an honest
# "nicht konfiguriert" error instead of a fake connection.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Must exactly match the "Authorized redirect URI" configured in Google
# Cloud Console for this OAuth client.
GOOGLE_HEALTH_REDIRECT_URI=https://api.vitaltwin.de/api/health/google/callback
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HEALTH_TOKEN_ENCRYPTION_KEY=
HEALTH_TOKEN_ENCRYPTION_KEY_VERSION=1
# Optional, all default sensibly if unset.
GOOGLE_HEALTH_AUTHORIZATION_URL=
GOOGLE_HEALTH_TOKEN_URL=
GOOGLE_HEALTH_REVOKE_URL=
GOOGLE_HEALTH_API_BASE_URL=
GOOGLE_HEALTH_SCOPES=
HEALTH_OAUTH_STATE_TTL_SECONDS=
HEALTH_INITIAL_SYNC_DAYS=
HEALTH_SYNC_OVERLAP_HOURS=

